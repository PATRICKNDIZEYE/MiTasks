{
  "name": "mitasks",
  "productName": "miTasks",
  "version": "1.0.0",
  "description": "A floating desktop task widget \u2014 click the bubble, capture the task, tick it done.",
  "main": "main.js",
  "scripts": {
    "native": "swiftc -O -framework EventKit -o native/bin/mitasks-cal native/mitasks-cal.swift",
    "start": "npm run native && env -u ELECTRON_RUN_AS_NODE electron .",
    "pack": "node build/pack.js",
    "install-app": "npm run pack && node build/install.js"
  },
  "author": "Ndizeye",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "@electron/packager": "^18.3.6"
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
